# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_FORMSPREE_ENDPOINT: Formspree endpoint for immediate email delivery of new orders
VITE_FORMSPREE_ENDPOINT="https://formspree.io/f/mvkknayb"

# VITE_META_PIXEL_ID: Meta Pixel ID for tracking PageView, ViewContent, InitiateCheckout, Lead, and Contact events.
VITE_META_PIXEL_ID="1690563088540181"

# META_CONVERSIONS_API_TOKEN: Meta Graph API System User Access Token for Conversions API (CAPI)
# Obtain from Meta Events Manager > Settings > Conversions API > Generate access token.
META_CONVERSIONS_API_TOKEN=""

# META_TEST_EVENT_CODE: Optional test code from Meta Events Manager Test Events tab
META_TEST_EVENT_CODE=""

# VITE_TIKTOK_PIXEL_ID: TikTok Pixel ID for tracking page, ViewContent, InitiateCheckout, PlaceAnOrder, and Contact.
VITE_TIKTOK_PIXEL_ID="DBNK5NJC77U6CGRG7ETG"

# TIKTOK_EVENTS_API_ACCESS_TOKEN: TikTok Business API Events API Access Token
# Obtain from TikTok Ads Manager > Assets > Events > Web Events > Manage > Settings > Generate Access Token.
TIKTOK_EVENTS_API_ACCESS_TOKEN=""
